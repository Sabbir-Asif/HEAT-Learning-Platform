    "test:coverage": "vitest run --coverage",
    "generate": "orval --config orval.config.ts"
  },
  "peerDependencies": {
    "react": "catalog:",
    "next": "catalog:"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@heat/config": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "eslint": "catalog:",
    "msw": "3.0.4",
    "next": "catalog:",
    "orval": "8.46.0",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@heat/contracts": "workspace:*",
    "@tanstack/react-query": "5.106.1",
    "server-only": "0.0.1",
    "zod": "catalog:"
  }
