{
  "name": "@heat/api-client",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./mocks": "./src/mocks.ts",
    "./schemas": "./src/generated/zod/schemas.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
