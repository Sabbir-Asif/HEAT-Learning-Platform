enum ModuleProgressStatus {
  LOCKED
  UNLOCKED
  IN_PROGRESS
  QUIZ_READY
  COMPLETED
}

model PlaybackSession {
  id                String    @id @default(uuid(7)) @db.Uuid
  enrollmentId      String    @db.Uuid
  videoId           String    @db.Uuid
  startedAt         DateTime  @default(now())
  lastSeenAt        DateTime?
  positionClaimedAt DateTime  @default(now())
  endedAt           DateTime?
  acceptedSeconds   Float     @default(0)
  lastSequence      Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  video      Video      @relation(fields: [videoId], references: [id], onDelete: Restrict)

  @@index([enrollmentId, videoId])
  @@index([videoId])
}

model VideoProgress {
  id                    String    @id @default(uuid(7)) @db.Uuid
  enrollmentId          String    @db.Uuid
  videoId               String    @db.Uuid
  watchedIntervals      Json      @default("[]")
  coverage              Float     @default(0)
  resumePositionSeconds Int       @default(0)
  lastSequence          Int       @default(0)
  firstWatchedAt        DateTime?
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  video      Video      @relation(fields: [videoId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, videoId])
  @@index([videoId])
}

model ModuleProgress {
  id           String               @id @default(uuid(7)) @db.Uuid
  enrollmentId String               @db.Uuid
  moduleId     String               @db.Uuid
  status       ModuleProgressStatus @default(LOCKED)
  unlockedAt   DateTime?
  startedAt    DateTime?
  quizReadyAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  module     Module     @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([enrollmentId, moduleId])
  @@index([moduleId, status])
}
