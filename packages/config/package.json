    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "typescript-eslint": "^8.72.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "js-yaml": "^5.5.0",
    "prettier": "catalog:",
    "sax": "1.6.1",
    "svgo": "4.1.0",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
