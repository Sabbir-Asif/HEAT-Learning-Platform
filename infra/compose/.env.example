# Copied to .env by `pnpm dev:up` when missing. Placeholder values, local dev only.
# Host ports are uncommon so the stack runs next to a local Postgres, Redis or Mailpit.
POSTGRES_USER=heat
POSTGRES_PASSWORD=heat_dev_password
POSTGRES_DB=heat
POSTGRES_PORT=5440
REDIS_PORT=6390
MAILPIT_SMTP_PORT=1035
MAILPIT_UI_PORT=8035
HTTP_PORT=80
