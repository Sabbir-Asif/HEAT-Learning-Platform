Cmnd_Alias HEAT_STATUS = /usr/bin/systemctl status *, /usr/bin/journalctl *, /usr/sbin/ufw status *, /usr/bin/fail2ban-client status *
Cmnd_Alias HEAT_SERVICES = /usr/bin/systemctl restart docker, /usr/bin/systemctl restart fail2ban, /usr/bin/systemctl reload ssh, /usr/bin/unattended-upgrade --dry-run *
__DEPLOY_USER__ ALL=(root) NOPASSWD: HEAT_STATUS, HEAT_SERVICES
