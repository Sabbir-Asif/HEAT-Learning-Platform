{
  "name": "heat-lms",
  "private": true,
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": "^22.22.0",
    "pnpm": ">=11.28.11 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
