{
  "name": "heat-lms",
  "private": true,
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": "^22.22.0",
    "pnpm": ">=11.28.11 <12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "turbo run format:check //#format:root",
    "format:root": "prettier --check . '!apps/**' '!packages/**'",
    "test:coverage": "turbo run test:coverage",
    "audit:deps": "node packages/config/bin/audit.mjs",
    "github:setup": "node packages/config/bin/github-setup.mjs",
    "ticket": "node packages/config/bin/ticket.mjs",
    "dev:up": "node infra/scripts/dev.mjs up",
    "dev:down": "node infra/scripts/dev.mjs down",
    "dev:reset": "node infra/scripts/dev.mjs reset"
  },
  "devDependencies": {
    "@heat/config": "workspace:*",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "turbo": "^2.11.10"
  },
  "prettier": "@heat/config/prettier"
}
