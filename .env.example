NODE_ENV=production

PUBLIC_DOMAIN=learn.example.ac.bd
ADMIN_DOMAIN=admin.example.ac.bd
PUBLIC_APP_URL=https://learn.example.ac.bd
ADMIN_APP_URL=https://admin.example.ac.bd
TRUSTED_ORIGINS=https://learn.example.ac.bd,https://admin.example.ac.bd
PUBLIC_APP_INTERNAL_URL=http://frontend-public:3000
API_INTERNAL_URL=http://api:4000
LETSENCRYPT_EMAIL=CHANGE_ME_admin_email_for_tls_notices
DATA_ROOT=/srv/heat

POSTGRES_USER=heat
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=heat
DATABASE_URL=postgresql://heat:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/heat
REDIS_URL=redis://redis:6379

AUTH_ACCESS_SECRET=CHANGE_ME_run_openssl_rand_base64_48
CSRF_SECRET=CHANGE_ME_run_openssl_rand_base64_48
AUTH_ENCRYPTION_KEY=CHANGE_ME_run_openssl_rand_base64_32
REVALIDATE_SECRET=CHANGE_ME_run_openssl_rand_base64_48
HLS_SIGNING_KEYS=k1:CHANGE_ME_run_openssl_rand_base64_48
HLS_ACTIVE_KEY_ID=k1

SUPER_ADMIN_EMAIL=admin@example.ac.bd
SUPER_ADMIN_PASSWORD=CHANGE_ME_at_least_12_characters

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USER=CHANGE_ME_YOUR_GMAIL_ADDRESS
SMTP_PASSWORD=CHANGE_ME_GMAIL_APP_PASSWORD
SMTP_FROM_ADDRESS=CHANGE_ME_YOUR_GMAIL_ADDRESS
SMTP_FROM_NAME=WSAP

EMAIL_DAILY_LIMIT=400
EMAIL_RESERVED_CAPACITY=100
EMAIL_BUDGET_VERIFICATION=250
EMAIL_BUDGET_PASSWORD=100
EMAIL_BUDGET_ENROLLMENT=100
EMAIL_BUDGET_CERTIFICATE=100

VIDEO_UPLOAD_DIR=/srv/heat/uploads
HLS_MEDIA_DIR=/srv/heat/hls
MEDIA_STORAGE_DIR=/srv/heat/media
CERTIFICATE_STORAGE_DIR=/srv/heat/certificates
VIDEO_UPLOAD_EXPIRY_HOURS=24
TRANSCODE_TIMEOUT_FACTOR=8
TRANSCODE_TIMEOUT_MIN_SECONDS=600
TRANSCODE_TIMEOUT_MAX_SECONDS=14400

CERTIFICATE_TITLE=Certificate of Completion
CERTIFICATE_INTRO=This is to certify that
CERTIFICATE_COMPLETION=has successfully completed the course
CERTIFICATE_VERIFY_LABEL=Verify this certificate at
CERTIFICATE_ORGANISATION_NAME=Women Safety Awareness Program, University of Dhaka
CERTIFICATE_ORGANISATION_ADDRESS=University of Dhaka, Dhaka 1000, Bangladesh
CERTIFICATE_SIGNATORY_ONE_NAME=CHANGE_ME_Project_Director_Name
CERTIFICATE_SIGNATORY_ONE_TITLE=Project Director, Women Safety Awareness Program
CERTIFICATE_SIGNATORY_TWO_NAME=CHANGE_ME_Vice_Chancellor_Name
CERTIFICATE_SIGNATORY_TWO_TITLE=Vice-Chancellor, University of Dhaka
CERTIFICATE_RENDER_TIMEOUT_MS=60000
CHROMIUM_EXECUTABLE_PATH=/usr/bin/chromium

ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
LOCKOUT_THRESHOLD=5
LOCKOUT_BASE_SECONDS=30
LOCKOUT_MAX_SECONDS=900
