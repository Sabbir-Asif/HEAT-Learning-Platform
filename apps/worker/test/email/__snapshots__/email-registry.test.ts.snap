// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`admin-invitation > matches the snapshot 1`] = `
{
  "subject": "You are invited to the HEAT admin console",
  "text": "HEAT

Hello Rahim,

You have been invited to the HEAT admin console. Set your password to begin.

Accept the invitation: https://admin.heat.example/accept-invite/inv456

The invitation expires on 14 November 2026 at 12:00 (Asia/Dhaka).

Questions? Write to support@heat.example.",
}
`;

exports[`certificate-ready > matches the snapshot 1`] = `
{
  "subject": "Your certificate for HEAT Basics is ready",
  "text": "HEAT

Hello Amina,

Congratulations on completing HEAT Basics. Your certificate is ready.

Verify your certificate: https://learn.heat.example/verify-certificate/CERT-001

Download it from your account: https://learn.heat.example/certificates

Questions? Write to support@heat.example.",
}
`;

exports[`enrollment-approved > matches the snapshot 1`] = `
{
  "subject": "Your enrollment in HEAT Basics is approved",
  "text": "HEAT

Hello Amina,

Your enrollment in HEAT Basics has been approved. You can start learning now.

Go to your dashboard: https://learn.heat.example/dashboard

Questions? Write to support@heat.example.",
}
`;

exports[`enrollment-reinstated > matches the snapshot 1`] = `
{
  "subject": "Your enrollment in HEAT Basics is active again",
  "text": "HEAT

Hello Amina,

Your enrollment in HEAT Basics has been reinstated. Your progress is kept.

Go to your dashboard: https://learn.heat.example/dashboard

Questions? Write to support@heat.example.",
}
`;

exports[`enrollment-rejected > matches the snapshot 1`] = `
{
  "subject": "Your enrollment request for HEAT Basics was not approved",
  "text": "HEAT

Hello Amina,

Your enrollment request for HEAT Basics was not approved.

Reason: Incomplete form

If you think this is a mistake, contact support.

Questions? Write to support@heat.example.",
}
`;

exports[`enrollment-removed > matches the snapshot 1`] = `
{
  "subject": "You were removed from HEAT Basics",
  "text": "HEAT

Hello Amina,

Your enrollment in HEAT Basics has been removed.

Reason: Duplicate account

If you think this is a mistake, contact support.

