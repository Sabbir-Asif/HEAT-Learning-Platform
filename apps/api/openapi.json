{
  "components": {
    "schemas": {
      "AdminMeResponseDto": {
        "properties": {
          "user": {
            "properties": {
              "email": {
                "type": "string"
              },
              "id": {
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string"
              },
              "mustChangePassword": {
                "type": "boolean"
              },
              "role": {
                "enum": [
                  "SUPER_ADMIN",
                  "ADMIN",
                  "STUDENT"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "email",
              "role",
              "mustChangePassword"
            ],
            "type": "object"
          }
        },
        "required": [
          "user"
        ],
        "type": "object"
      },
      "ChangePasswordRequestDto": {
        "properties": {
          "currentPassword": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "newPassword": {
            "maxLength": 256,
            "minLength": 12,
            "type": "string"
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object"
      },
      "HealthResponseDto": {
        "properties": {
          "status": {
            "enum": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "MeResponseDto": {
        "properties": {
          "enrollments": {
            "items": {
              "properties": {
                "courseId": {
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                  "type": "string"
                },
                "courseSlug": {
                  "type": "string"
                },
                "courseTitle": {
                  "type": "string"
                },
                "reason": {
                  "type": "string"
                },
                "status": {
                  "enum": [
                    "PENDING_VERIFICATION",
                    "PENDING_APPROVAL",
                    "APPROVED",
                    "COMPLETED",
                    "REJECTED",
                    "EXPIRED",
                    "REMOVED"
                  ],
                  "type": "string"
                }
              },
              "required": [
                "courseId",
                "courseSlug",
                "courseTitle",
                "status"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "user": {
            "properties": {
              "email": {
                "type": "string"
              },
              "emailVerified": {
                "type": "boolean"
              },
              "id": {
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
                "type": "string"
              },
              "mustChangePassword": {
                "type": "boolean"
              },
              "name": {
                "type": "string"
              },
              "role": {
                "enum": [
                  "SUPER_ADMIN",
                  "ADMIN",
                  "STUDENT"
                ],
                "type": "string"
              }
            },
            "required": [
              "id",
              "email",
              "role",
              "emailVerified",
              "mustChangePassword"
            ],
            "type": "object"
          }
        },
        "required": [
          "user",
          "enrollments"
        ],
        "type": "object"
      },
      "SignInRequestDto": {
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "type": "object"
      }
    }
  },
