{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/main.js",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "scripts": {
    "dev": "nest start --watch --env-file .env",
    "build": "nest build",
    "start": "node dist/main.js",
    "recover-super-admin": "node dist/cli/main.js recover-super-admin",
    "insights-backfill": "node dist/cli/insights-backfill.main.js insights-backfill",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "openapi": "node dist/openapi/emit.js",
    "test:integration": "vitest run --config vitest.integration.config.mjs"
  },
  "dependencies": {
    "@heat/contracts": "workspace:*",
    "@heat/db": "workspace:*",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/swagger": "12.1.2",
    "argon2": "0.45.2",
    "helmet": "^8.3.0",
    "ioredis": "6.0.0",
    "jose": "^6.2.17",
    "multer": "2.5.0",
    "nestjs-zod": "5.6.0",
    "nodemailer": "^10.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@heat/config": "workspace:*",
    "@nestjs/cli": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@types/multer": "^2.3.0",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "eslint": "catalog:",
    "fast-check": "4.10.2",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
