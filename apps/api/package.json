{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/main.js",
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    }
  },
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "format:check": "prettier --check . --ignore-path ../../.gitignore --ignore-path .prettierignore",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "openapi": "node dist/openapi/emit.js",
    "test:integration": "vitest run --config vitest.integration.config.mjs"
  },
  "dependencies": {
    "@heat/contracts": "workspace:*",
    "@heat/db": "workspace:*",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@nestjs/swagger": "12.1.1",
    "argon2": "0.45.2",
    "helmet": "^8.3.0",
    "ioredis": "6.0.0",
    "jose": "^6.2.15",
    "nestjs-zod": "5.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@heat/config": "workspace:*",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.0",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
