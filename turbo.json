{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".nvmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "prisma:generate"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build", "prisma:generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "prisma:generate"]
    },
    "test": {
      "dependsOn": ["^build", "prisma:generate"]
    },
    "@heat/config#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/*/public/brand/**",
        "$TURBO_ROOT$/packages/ui/src/styles.css",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/docs/guides/*.md"
      ]
    },
    "@heat/config#test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/*/public/brand/**",
        "$TURBO_ROOT$/packages/ui/src/styles.css",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/docs/guides/*.md"
      ]
    },
    "format:check": {},
    "//#format:root": {},
    "test:coverage": {
      "dependsOn": ["^build", "prisma:generate"],
      "outputs": ["coverage/**"]
    },
    "openapi": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "!openapi.json"],
      "outputs": ["openapi.json"]
    },
    "generate": {
      "dependsOn": ["api#openapi"],
      "inputs": [
        "orval.config.ts",
        "src/mutator/**",
        "src/server/**",
        "$TURBO_ROOT$/apps/api/openapi.json"
      ],
      "outputs": ["src/generated/**"]
    },
    "prisma:generate": {
      "inputs": ["prisma/**", "prisma.config.ts"],
      "outputs": ["src/generated/**"]
    }
  }
}
