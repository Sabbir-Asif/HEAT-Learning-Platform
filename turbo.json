{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".nvmrc"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["NEXT_PUBLIC_*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "format:check": {},
    "//#format:root": {},
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "openapi": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "!openapi.json"],
      "outputs": ["openapi.json"]
    },
    "generate": {
      "dependsOn": ["api#openapi"],
      "inputs": ["orval.config.ts", "src/mutator/**", "$TURBO_ROOT$/apps/api/openapi.json"],
      "outputs": ["src/generated/**"]
    }
  }
}
